    {
      "source": "/core-concepts/contracts",
      "destination": "/core-concepts/creating-contracts"
    },
    {
      "source": "/core-concepts/hash-chain",
      "destination": "/things-to-know/hash-chain"
    },
    {
      "source": "/core-concepts/installation",
      "destination": "/quickstart"
    },
    {
      "source": "/core-concepts/notifications",
      "destination": "/core-concepts/notifications/subscribing"
    },
    {
      "source": "/core-concepts/notifications/connecting",
      "destination": "/core-concepts/connecting"
    },
    {
      "source": "/core-concepts/references",
      "destination": "/core-concepts/external-references"
    },
    {
      "source": "/core-concepts/steps",
      "destination": "/core-concepts/tracking-workflows"
    },
    {
      "source": "/core-concepts/thread-collaboration/managing-access",
      "destination": "/things-to-know/access-levels"
    },
    {
      "source": "/things-to-know/contracts",
      "destination": "/core-concepts/creating-contracts"
    },
    {
      "source": "/things-to-know/steps",
      "destination": "/core-concepts/tracking-workflows"
    },
    {
      "source": "/things-to-know/notifications",
      "destination": "/core-concepts/notifications/subscribing"
    },
    {
      "source": "/things-to-know/overview",
      "destination": "/core-concepts/overview"
    }
  ]
}
