{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Threadify Documentation",
  "logo": {
    "dark": "/logo-dark.svg",
    "light": "/logo-light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000",
    "anchors": {
      "from": "#000000",
      "to": "#666666"
    }
  },
  "topbarCtaButton": {
    "name": "Get a license",
    "url": "https://threadify.dev/signup"
  },
  "navigation": [
    {
      "group": "Get started",
      "pages": [
        "introduction",
        "quickstart",
        "self-hosting",
        "authentication"
      ]
    },
    {
      "group": "Concepts",
      "pages": [
        "core-concepts/overview",
        "core-concepts/threads",
        "core-concepts/tracking-workflows",
        "core-concepts/sub-steps",
        "core-concepts/external-references",
        "core-concepts/ending-threads",
        "core-concepts/entity-profiles"
      ]
    },
    {
      "group": "Contracts",
      "pages": [
        "core-concepts/creating-contracts",
        "core-concepts/contract-rules",
        "core-concepts/working-with-contracts",
        "core-concepts/execution-waits",
        "core-concepts/decisions"
      ]
    },
    {
      "group": "SDKs",
      "pages": [
        {
          "group": "Install",
          "pages": [
            "core-concepts/installation/javascript",
            "core-concepts/installation/go",
            "core-concepts/installation/python"
          ]
        },
        "core-concepts/connecting",
        "core-concepts/browser",
        "core-concepts/idempotency",
        "core-concepts/handling-failures",
        {
          "group": "Read history",
          "pages": [
            "core-concepts/data-retrieval/getting-threads",
            "core-concepts/data-retrieval/querying-steps",
            "core-concepts/data-retrieval/validation-results",
            "core-concepts/data-retrieval/thread-chains"
          ]
        },
        {
          "group": "Work with other parties",
          "pages": [
            "core-concepts/thread-collaboration/inviting-parties",
            "core-concepts/thread-collaboration/joining-threads"
          ]
        },
        {
          "group": "Notifications",
          "pages": [
            "core-concepts/notifications/subscribing",
            "core-concepts/notifications/handling",
            "core-concepts/notifications/unsubscribing"
          ]
        }
      ]
    },
    {
      "group": "Integrations",
      "pages": [
        "opentelemetry",
        "core-concepts/mcp-integration",
        "cli",
        "personal-ai-gateway"
      ]
    },
    {
      "group": "Operate",
      "pages": [
        "plans-and-limits",
        "things-to-know/access-levels",
        "things-to-know/hash-chain",
        "troubleshooting"
      ]
    },
    {
      "group": "GraphQL API",
      "pages": [
        "api-reference/overview",
        "api-reference/thread-queries",
        "api-reference/step-queries",
        "api-reference/validation-queries",
        "api-reference/contract-queries",
        "api-reference/entity-profile-queries",
        "api-reference/integrity-verification"
      ]
    }
  ],
  "footerSocials": {
    "website": "https://threadify.dev",
    "github": "https://github.com/ThreadifyDev"
  },
  "search": {
    "prompt": "Ask me anything about Threadify..."
  },
  "api": {
    "maintainOrder": true
  },
  "redirects": [
    {
      "source": "/core-concepts/access-levels",
